<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="AssistantWindow.uss" />

    <ui:VisualElement name="assistant-root" class="assistant-root">
        <!-- Tabs will be inserted here by code -->
        <ui:VisualElement name="tabbar-host" class="tabbar-host" />

        <!-- All tabs (Masterlists / Animation / Effects / Scripts) are added here by code -->
        <ui:VisualElement name="panels-root" class="panels-root" />
    </ui:VisualElement>
</ui:UXML>